ENVIRONMENT=development
# Set DEBUG=true locally to see tracebacks; 500 responses stay generic when false.
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/financial_audit_db
TEMP_UPLOAD_DIR=./temporary_uploads
# Documents stuck in "processing" longer than this are recovered at startup.
PROCESSING_STALE_MINUTES=15
MAX_DOCUMENTS_PER_WORKSPACE=20
MAX_WORKSPACE_BYTES=200000000
EXTRACTION_TIMEOUT_SECONDS=300
UPLOAD_RATE_LIMIT_PER_MINUTE=20
CLEANUP_INTERVAL_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_SECURE=false
# WEAVIATE_API_KEY=
CHAT_RATE_LIMIT_PER_MINUTE=10
LLM_API_KEY=
LOG_LEVEL=INFO