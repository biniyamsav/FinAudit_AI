ENVIRONMENT=development
# Set DEBUG=true locally to see tracebacks; 500 responses stay generic when false.
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/financial_audit_db
TEMP_UPLOAD_DIR=./temporary_uploads
# Documents stuck in "processing" longer than this are recovered at startup.
PROCESSING_STALE_MINUTES=15
CLEANUP_INTERVAL_MINUTES=30
LLM_PROVIDER_MODE=mock
LLM_API_KEY=
LOG_LEVEL=INFO